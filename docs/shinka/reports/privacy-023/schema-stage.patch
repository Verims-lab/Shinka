diff --git a/base44/entities/PrivacyRecoveryReceipt.jsonc b/base44/entities/PrivacyRecoveryReceipt.jsonc
new file mode 100644
index 0000000..5fe9dbb
--- /dev/null
+++ b/base44/entities/PrivacyRecoveryReceipt.jsonc
@@ -0,0 +1,28 @@
+{
+  "name": "PrivacyRecoveryReceipt",
+  "type": "object",
+  "description": "SHA-256 of a random 256-bit read-only outcome capability; 24-hour validity. No identity, health payload or plaintext token. Direct access denied.",
+  "properties": {
+    "token_hash": {
+      "type": "string"
+    },
+    "request_id": {
+      "type": "string"
+    },
+    "expires_at": {
+      "type": "string",
+      "format": "date-time"
+    }
+  },
+  "required": [
+    "token_hash",
+    "request_id",
+    "expires_at"
+  ],
+  "rls": {
+    "read": false,
+    "create": false,
+    "update": false,
+    "delete": false
+  }
+}
diff --git a/base44/entities/UserPrivacyRequest.jsonc b/base44/entities/UserPrivacyRequest.jsonc
new file mode 100644
index 0000000..94f3f14
--- /dev/null
+++ b/base44/entities/UserPrivacyRequest.jsonc
@@ -0,0 +1,69 @@
+{
+  "name": "UserPrivacyRequest",
+  "type": "object",
+  "description": "Owner-confirmed privacy lifecycle. Pending platform erasure is not permanent deletion. Operational storage, not a uniqueness or transaction guarantee.",
+  "properties": {
+    "user_id": {
+      "type": "string"
+    },
+    "request_key": {
+      "type": "string"
+    },
+    "kind": {
+      "type": "string",
+      "enum": [
+        "WITHDRAW_HEALTH",
+        "DELETE_ACCOUNT"
+      ]
+    },
+    "status": {
+      "type": "string",
+      "enum": [
+        "IN_PROGRESS",
+        "COMPLETED",
+        "NATIVE_REMOVAL_PENDING",
+        "PLATFORM_PENDING"
+      ]
+    },
+    "requested_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "grant_at": {
+      "type": [
+        "string",
+        "null"
+      ],
+      "format": "date-time"
+    },
+    "consent_version": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "completed_at": {
+      "type": [
+        "string",
+        "null"
+      ],
+      "format": "date-time"
+    }
+  },
+  "required": [
+    "user_id",
+    "request_key",
+    "kind",
+    "status",
+    "requested_at",
+    "grant_at",
+    "consent_version",
+    "completed_at"
+  ],
+  "rls": {
+    "read": false,
+    "create": false,
+    "update": false,
+    "delete": false
+  }
+}
