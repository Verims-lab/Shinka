{
  "name": "UserCycleSettings",
  "type": "object",
  "description": "Shinka user_cycle_settings. SRC-05 v1.2 / SRC-07 v1.2. Optional absent fields mean logical NULL; native timestamps mapped under OD-004. Backend access only.",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "period_duration_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "initial_cycle_length_days": {
      "type": "integer",
      "minimum": 15,
      "maximum": 60
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
