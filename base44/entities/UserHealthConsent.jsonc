{
  "name": "UserHealthConsent",
  "type": "object",
  "description": "Shinka user_health_consent. SRC-05 v1.2 / SRC-07 v1.2. Optional absent fields mean logical NULL; native timestamps mapped under OD-004. Backend access only.",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "GRANTED",
        "WITHDRAWN"
      ]
    },
    "consent_version": {
      "type": "string",
      "minLength": 1
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "consent_status",
    "consent_version"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
