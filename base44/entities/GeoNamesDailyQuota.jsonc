{
  "name": "GeoNamesDailyQuota",
  "type": "object",
  "description": "INTERNAL TOOLING. One operator-prepared APP_CREDITS_V1 row; conditional credit reservations only. Missing/duplicate/legacy state denies provider access. No user, place or credential data. Legacy fields retained for staged schema compatibility, not read as zero usage.",
  "properties": {
    "scope": {"type": "string", "enum": ["APP_CREDITS_V1"]},
    "revision": {"type": "integer", "minimum": 0},
    "window_hour": {"type": "integer", "minimum": 0},
    "buckets": {"type": "array", "maxItems": 25, "items": {"type": "object", "properties": {"hour": {"type": "integer", "minimum": 0}, "credits": {"type": "integer", "minimum": 0, "maximum": 8000}}, "required": ["hour", "credits"]}},
    "quota_date": {"type": "string", "format": "date"},
    "count": {"type": "integer", "minimum": 0}
  },
  "rls": {"create": false, "read": false, "update": false, "delete": false}
}
