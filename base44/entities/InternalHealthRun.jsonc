{
  "name": "InternalHealthRun",
  "type": "object",
  "description": "INTERNAL TOOLING \u2014 Health run history. NOT a Shinka product-domain entity; excluded from the 20-entity contract. Must never contain tokens, secrets, health records, message bodies or PII.",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "build_marker": {
      "type": "string"
    },
    "health_catalog_version": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "description": "FULL or SUITE:<id>"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "Gate status"
    },
    "planned": {
      "type": "number"
    },
    "attempted": {
      "type": "number"
    },
    "executed": {
      "type": "number"
    },
    "passed": {
      "type": "number"
    },
    "failed": {
      "type": "number"
    },
    "warnings": {
      "type": "number"
    },
    "blocked": {
      "type": "number"
    },
    "not_run": {
      "type": "number"
    },
    "not_applicable": {
      "type": "number"
    },
    "report_json": {
      "type": "string",
      "description": "Compact case index [[id,status],...] (fits the field size limit)"
    },
    "report_file_uri": {
      "type": "string",
      "description": "Private file URI of the full redacted report JSON"
    },
    "report_digest": {
      "type": "string",
      "description": "SHA-256 of normalized full redacted report; immutable retry identity. Optional for historical rows."
    }
  },
  "required": [
    "run_id",
    "build_marker",
    "health_catalog_version",
    "scope",
    "status"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
