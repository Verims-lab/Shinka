{
  "name": "UserPeriodRecord",
  "type": "object",
  "description": "Shinka user_period_record. SRC-05 v1.2 / SRC-07 v1.2. Optional absent fields mean logical NULL; native timestamps mapped under OD-004. Backend access only.",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "period_start_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "period_start_date"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
