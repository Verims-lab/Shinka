{
  "name": "PrivacyRecoveryReceipt",
  "type": "object",
  "description": "SHA-256 of a random 256-bit read-only outcome capability; 24-hour validity. No identity, health payload or plaintext token. Direct access denied.",
  "properties": {
    "token_hash": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token_hash",
    "request_id",
    "expires_at"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
