{
  "name": "UserCyclePrediction",
  "type": "object",
  "description": "Shinka user_cycle_prediction. SRC-05 v1.2 / SRC-07 v1.2. Optional absent fields mean logical NULL; native timestamps mapped under OD-004. Backend access only.",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_period_id": {
      "type": "string",
      "minLength": 1
    },
    "predicted_start_date": {
      "type": "string",
      "format": "date"
    },
    "predicted_end_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_cycle_length_days": {
      "type": "integer",
      "minimum": 1
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "predicted_start_date",
    "predicted_end_date",
    "estimated_cycle_length_days",
    "calculated_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
